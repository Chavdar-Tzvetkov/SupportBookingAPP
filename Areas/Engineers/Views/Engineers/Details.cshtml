@model SupportBookingAPP.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
}

<h2>Booking Details</h2>
<hr />
<dl class="row">
    <dt class="col-sm-3">User</dt>
    <dd class="col-sm-9">@Model.User?.Email</dd>

    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@Model.SupportCategory?.Name</dd>

    <dt class="col-sm-3">Slot Start</dt>
    <dd class="col-sm-9">@Model.SlotStart.ToString("g")</dd>

    <dt class="col-sm-3">Slot End</dt>
    <dd class="col-sm-9">@Model.SlotEnd.ToString("g")</dd>

    <dt class="col-sm-3">Issue</dt>
    <dd class="col-sm-9">@Model.IssueDescription</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @if (Model.IsCompleted)
        {
            <span class="badge bg-success">Completed</span>
        }
        else
        {
            <span class="badge bg-warning text-dark">Pending</span>
        }
    </dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" asp-controller="Dashboard" class="btn btn-secondary">Back</a>
