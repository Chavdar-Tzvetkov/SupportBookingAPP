@using Microsoft.AspNetCore.Identity
@using SupportBookingAPP.Areas.Engineers.Models
@using SupportBookingAPP.Models
@model EngineerDashboardViewModel

@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Engineer Dashboard"; 
    var currentUser = await UserManager.GetUserAsync(User);
    var isEngineer = User.IsInRole("Engineer");
}


<nav class="navbar navbar-expand-lg navbar-light bg-light mb-5 px-3 shadow-sm rounded">
    <div class="container-fluid">
        <span class="navbar-brand fw-bold">Engineer Panel</span>
        <div class="d-flex">
            <a class="btn btn-outline-secondary me-3" asp-area="" asp-controller="Home" asp-action="Index">🏠 Home</a>
            <a class="btn btn-outline-primary me-3" asp-area="" asp-controller="Bookings" asp-action="Index">📋 Bookings</a>
            <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-danger">Logout</button>
            </form>
        </div>
    </div>
</nav>

<h1 class="mb-5">Engineer Dashboard</h1>

<p>
    <a asp-area="" asp-controller="Bookings" asp-action="Create" class="btn btn-success">📅 New Booking</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="thead-dark">
        <tr>
            <th>Start</th>
            <th>End</th>
            <th>Issue</th>
            <th>Category</th>
            <th>User</th>
            <th>Engineer</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Bookings)
        {
            var isOwner = item.UserId == currentUser?.Id;
            var isEngineers = item.Engineer?.Email == currentUser?.Email;

            <tr class="@(item.IsCompleted ? "table-success" : "")">
                <td>@item.SlotStart.ToString("g")</td>
                <td>@item.SlotEnd.ToString("g")</td>
                <td>@item.IssueDescription</td>
                <td>@item.SupportCategory?.Name</td>
                <td>@item.User?.Email</td>
                <td>@item.Engineer?.Name</td>
                <td>
                    @if (item.IsCompleted)
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                </td>
                <td>
                    @if (isEngineer || isOwner)
                    {
                        <a asp-area="" asp-controller="Bookings" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-area="" asp-controller="Bookings" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    }
                    <a asp-area="" asp-controller="Bookings" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Details</a>

                    @* Show 'Complete' button only for engineer if booking is not done *@
                    @if (isEngineer && !item.IsCompleted)
                    {
                        <form asp-area="" asp-controller="Bookings" asp-action="MarkAsCompleted" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-success" title="Mark as completed">
                                ✔ Complete
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="card mt-5 shadow-sm">
    <div class="card-header bg-warning fw-bold">
        🔔 Your Notifications
    </div>
    <ul class="list-group list-group-flush" style="max-height: 250px; overflow-y: auto;">
        @if (Model.Notifications.Any())
        {
            @foreach (var n in Model.Notifications)
            {
                <li class="list-group-item">
                    📌 <strong>Booking #@n.BookingId</strong><br />
                    📄 <em>@n.Booking.IssueDescription</em><br />
                    Notify at: @n.NotifyAt.ToString("g")<br />
                    Status: @(n.Sent ? "✅ Sent" : "⏳ Pending")
                </li>
            }
        }
        else
        {
            <li class="list-group-item text-muted">No new notifications.</li>
        }
    </ul>
</div>


