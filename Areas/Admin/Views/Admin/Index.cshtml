@model SupportBookingAPP.Areas.Admin.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1 class="mb-4 fw-bold">🛠 Admin Dashboard</h1>

<div class="accordion" id="adminDashboardAccordion">

    <!-- Summary Tiles -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-primary text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title fs-5">👩‍💻 Engineers</h5>
                    <p class="fs-2 fw-semibold text-primary">@Model.Engineers?.Count()</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-warning text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title fs-5">📂 Categories</h5>
                    <p class="fs-2 fw-semibold text-warning">@Model.Categories?.Count()</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-success text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title fs-5">📅 Bookings</h5>
                    <p class="fs-2 fw-semibold text-success">@Model.Bookings?.Count()</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Engineers Section -->
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingEngineers">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEngineers">
                👨‍🔧 Engineers
            </button>
        </h2>
        <div id="collapseEngineers" class="accordion-collapse collapse show" data-bs-parent="#adminDashboardAccordion">
            <div class="accordion-body">
                @if (Model.Engineers != null && Model.Engineers.Any())
                {
                    <table class="table table-striped table-bordered align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var eng in Model.Engineers)
                            {
                                <tr>
                                    <td>@eng.Name</td>
                                    <td>@eng.Email</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No engineers available.</p>
                }
            </div>
        </div>
    </div>

    <!-- Categories Section -->
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingCategories">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCategories">
                📁 Support Categories
            </button>
        </h2>
        <div id="collapseCategories" class="accordion-collapse collapse" data-bs-parent="#adminDashboardAccordion">
            <div class="accordion-body">
                @if (Model.Categories != null && Model.Categories.Any())
                {
                    <table class="table table-striped table-bordered align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in Model.Categories)
                            {
                                <tr>
                                    <td>@cat.Name</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No categories defined.</p>
                }
            </div>
        </div>
    </div>

    <!-- Bookings Section -->
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingBookings">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBookings">
                📅 Recent Bookings
            </button>
        </h2>
        <div id="collapseBookings" class="accordion-collapse collapse" data-bs-parent="#adminDashboardAccordion">
            <div class="accordion-body">
                <table class="table table-striped table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>User</th>
                            <th>Engineer</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Issue</th>
                            <th>Category</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.Bookings)
                        {
                            <tr>
                                <td>@booking.User?.Email</td>
                                <td>@booking.Engineer?.Name</td>
                                <td>@booking.SlotStart.ToString("g")</td>
                                <td>@booking.SlotEnd.ToString("g")</td>
                                <td>@booking.IssueDescription</td>
                                <td>@booking.SupportCategory?.Name</td>
                                <td>
                                    <a asp-area="" asp-controller="Bookings" asp-action="Edit" asp-route-id="@booking.Id" class="btn btn-sm btn-primary me-1">Edit</a>
                                    <a asp-area="" asp-controller="Bookings" asp-action="Delete" asp-route-id="@booking.Id" class="btn btn-sm btn-danger me-1">Delete</a>
                                    <a asp-area="" asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-secondary">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
