@model IEnumerable<SupportBookingAPP.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
}

<h1 class="mb-4">Notifications</h1>

<p>
    <a asp-action="Create" class="btn btn-success">🔔 Create New Notification</a>
</p>

<table class="table table-bordered table-striped">
    <thead class="thead-dark">
        <tr>
            <th>Notify At</th>
            <th>Sent</th>
            <th>Booking Slot</th>
            <th>Booking User</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NotifyAt.ToString("f")</td>
                <td>@(item.Sent ? "✅ Yes" : "❌ No")</td>
                <td>@item.Booking?.SlotStart.ToString("g")</td>
                <td>@item.Booking?.User?.Email</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
