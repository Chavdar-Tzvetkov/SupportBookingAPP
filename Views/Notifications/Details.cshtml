@model SupportBookingAPP.Models.Notification
@{
    ViewData["Title"] = "Notification Details";
}

<h1>Notification Details</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Notify At</dt>
    <dd class="col-sm-9">@Model.NotifyAt.ToString("f")</dd>

    <dt class="col-sm-3">Sent</dt>
    <dd class="col-sm-9">@((Model.Sent) ? "✅ Yes" : "❌ No")</dd>

    <dt class="col-sm-3">Booking Slot</dt>
    <dd class="col-sm-9">@Model.Booking?.SlotStart.ToString("g")</dd>

    <dt class="col-sm-3">User Email</dt>
    <dd class="col-sm-9">@Model.Booking?.User?.Email</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
