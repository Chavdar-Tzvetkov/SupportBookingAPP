@model SupportBookingAPP.Models.Notification
@{
    ViewData["Title"] = "Edit Notification";
}

<h1>Edit Notification</h1>
<hr />

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="BookingId"></label>
        <select asp-for="BookingId" class="form-control" asp-items="ViewBag.BookingId"></select>
        <span asp-validation-for="BookingId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="NotifyAt"></label>
        <input asp-for="NotifyAt" class="form-control" type="datetime-local" />
        <span asp-validation-for="NotifyAt" class="text-danger"></span>
    </div>

    <div class="form-group form-check">
        <input class="form-check-input" asp-for="Sent" />
        <label asp-for="Sent" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
