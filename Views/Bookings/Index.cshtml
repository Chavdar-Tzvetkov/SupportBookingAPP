@model IEnumerable<SupportBookingAPP.Models.Booking>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Bookings Overview";
    var currentUser = await UserManager.GetUserAsync(User);
    var isAdmin = User.IsInRole("Admin");
}

<h1 class="mb-4">Bookings Overview</h1>

<p>
    <a asp-action="Create" class="btn btn-success">📅 New Booking</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="thead-dark">
        <tr>
            <th>Start</th>
            <th>End</th>
            <th>Issue</th>
            <th>Category</th>
            <th>User</th>
            <th>Engineer</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var isOwner = item.UserId == currentUser?.Id;
            var isEngineer = item.Engineer?.Email == currentUser?.Email;

            <tr>
                <td>@item.SlotStart.ToString("g")</td>
                <td>@item.SlotEnd.ToString("g")</td>
                <td>@item.IssueDescription</td>
                <td>@item.SupportCategory?.Name</td>
                <td>@item.User?.Email</td>
                <td>@item.Engineer?.Name</td>
                <td>
                    @if (isAdmin || isEngineer || isOwner)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    }
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
