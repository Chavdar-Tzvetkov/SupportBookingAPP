@model IEnumerable<SupportBookingAPP.Models.Booking>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.SlotStart)</th>
            <th>@Html.DisplayNameFor(model => model.SlotEnd)</th>
            <th>@Html.DisplayNameFor(model => model.IssueDescription)</th>
            <th>User Email</th>
            <th>Engineer Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SlotStart.ToString("g")</td>
                <td>@item.SlotEnd.ToString("g")</td>
                <td>@item.IssueDescription</td>
                <td>@(item.User?.Email ?? "N/A")</td>
                <td>@(item.Engineer?.Name ?? "N/A")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
