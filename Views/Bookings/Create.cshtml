@model SupportBookingAPP.Models.Booking

@{
    ViewData["Title"] = "Create Booking";
}

<h1>Create a New Booking</h1>
<hr />

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="EngineerId" class="control-label"></label>
        <select asp-for="EngineerId" class="form-control" asp-items="ViewBag.EngineerId">
            <option value="">-- Select Engineer --</option>
        </select>
        <span asp-validation-for="EngineerId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="SupportCategoryId" class="control-label"></label>
        <select asp-for="SupportCategoryId" class="form-control" asp-items="ViewBag.SupportCategoryId">
            <option value="">-- Select Category --</option>
        </select>
        <span asp-validation-for="SupportCategoryId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="SlotStart"></label>
        <input asp-for="SlotStart" class="form-control" type="datetime-local" />
        <span asp-validation-for="SlotStart" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="SlotEnd"></label>
        <input asp-for="SlotEnd" class="form-control" type="datetime-local" />
        <span asp-validation-for="SlotEnd" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IssueDescription"></label>
        <textarea asp-for="IssueDescription" class="form-control" rows="4"></textarea>
        <span asp-validation-for="IssueDescription" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Confirm Booking</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
