@model SupportBookingAPP.Models.Booking
@{
    ViewData["Title"] = "Booking Details";
}

<h1>Booking Details</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Start</dt>
    <dd class="col-sm-9">@Model.SlotStart.ToString("f")</dd>

    <dt class="col-sm-3">End</dt>
    <dd class="col-sm-9">@Model.SlotEnd.ToString("f")</dd>

    <dt class="col-sm-3">Issue Description</dt>
    <dd class="col-sm-9">@Model.IssueDescription</dd>

    <dt class="col-sm-3">User Email</dt>
    <dd class="col-sm-9">@Model.User?.Email</dd>

    <dt class="col-sm-3">Engineer Name</dt>
    <dd class="col-sm-9">@Model.Engineer?.Name</dd>
</dl>

<a asp-action="Index" class="btn btn-outline-secondary">← Back to List</a>
